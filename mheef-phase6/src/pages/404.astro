---
import Base from '../layouts/Base.astro';
import { withBase } from '../utils/paths';
---

<Base title="Page not found">
  <h1 class="text-3xl font-semibold tracking-tight">Page not found</h1>
  <p class="mt-3 max-w-xl text-sm leading-relaxed text-white/65">
    That address doesn't match anything in the atlas. The facility may have been renamed, or the
    link may be mistyped.
  </p>
  <div class="mt-8 flex flex-wrap gap-3 text-sm">
    <a
      href={withBase('/')}
      class="rounded-full border border-accent-400/40 bg-accent-400/10 px-4 py-2 font-medium text-accent-300 transition-colors hover:text-white"
    >
      Open the globe
    </a>
    <a
      href={withBase('/facilities/')}
      class="rounded-full border border-white/15 px-4 py-2 font-medium text-white/75 transition-colors hover:text-white"
    >
      Browse all facilities
    </a>
  </div>
</Base>
